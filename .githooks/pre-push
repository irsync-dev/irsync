#!/bin/sh
# Refuses a push whose commits are not rustfmt-clean.
#
# Once the repository is hosted on GitHub, the CI workflow there
# (.github/workflows/ci.yml) checks formatting too; this hook catches a
# formatting slip before the push leaves the machine.
# Install once per clone:
#
#     git config core.hooksPath .githooks
#
# Each pushed commit is checked in a throwaway worktree, so what matters is
# what the remote will receive, not what the working tree looks like right
# now: uncommitted drift does not block a push, and committed drift is not
# excused by an uncommitted fix.
set -eu

zero=0000000000000000000000000000000000000000
tmp=$(mktemp -d)
cleanup() {
    for wt in "$tmp"/*; do
        [ -d "$wt" ] && git worktree remove --force "$wt" >/dev/null 2>&1
    done
    rm -rf "$tmp"
}
trap cleanup EXIT

status=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
    # Deleting a remote branch pushes nothing.
    [ "$local_sha" = "$zero" ] && continue

    wt="$tmp/$local_sha"
    git worktree add --quiet --detach "$wt" "$local_sha"
    if ! out=$(cd "$wt" && cargo fmt --all -- --check 2>&1); then
        status=1
        echo "pre-push: $local_ref (${local_sha%"${local_sha#???????}"}) is not rustfmt-clean:" >&2
        echo "$out" | sed -n 's|^Diff in '"$wt"'/\(.*\):[0-9]*:$|    \1|p' | sort -u >&2
    fi
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: run 'cargo fmt --all', commit the result, and push again." >&2
fi
exit "$status"
