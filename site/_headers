# Response headers, applied by Cloudflare to the Workers' static files.
# Staging (dev.irsync.org) is public but not indexed; production (irsync.org)
# is. Both serve these same files.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/install.sh
  Content-Type: text/plain; charset=utf-8

https://dev.irsync.org/*
  X-Robots-Tag: noindex

# site/wrangler.jsonc turns off the workers.dev hosts. Should one be turned
# on, it is not indexed either: <worker>.<account>.workers.dev, and the
# preview hosts <version>-<worker>.<account>.workers.dev.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
