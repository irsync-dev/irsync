# Makes pandoc's man output the same whatever pandoc wrote it, and clean for
# mandoc and groff. tools/build-man.sh runs every page through it.
#
# pandoc before 3.1.12 (Ubuntu 24.04 has 3.1.3) writes inline code in a font
# "V" that it defines at the top of the page, and code blocks as .nf with a
# font "C". groff and mandoc know neither font. Newer pandoc writes CR and
# .EX/.EE, which this turns the old form into.

# s with every \f[from] turned into \f[to]. Not gsub: awks disagree on a
# backslash in its replacement.
function font(s, from, to,    out, at) {
    from = "\\f[" from "]"
    out = ""
    while ((at = index(s, from)) > 0) {
        out = out substr(s, 1, at - 1) "\\f[" to "]"
        s = substr(s, at + length(from))
    }
    return out s
}

{ line[NR] = $0 }
END {
    body = 0
    for (i = 1; i <= NR; i++) {
        l = line[i]
        if (l ~ /^\.S[HS]( |$)/) body = 1
        # The block that defines the V fonts: a comment, then .ie and .el,
        # each closed by a line ".\}".
        if (!body && l ~ /^\.\\" Define V font/) {
            closed = 0
            while (closed < 2 && i < NR) if (line[++i] == ".\\}") closed++
            if (closed < 2) {
                print "normalize.awk: the V font block does not end" > "/dev/stderr"
                exit 1
            }
            continue
        }
        # The comment that names the pandoc version, and the empty comment
        # after it.
        if (!body && l ~ /^\.\\" Automatically generated by Pandoc/) {
            if (i < NR && line[i + 1] == ".\\\"") i++
            continue
        }
        # Old pandoc turns hyphenation on after .TH; new pandoc does not.
        if (!body && l == ".hy") continue
        # pandoc starts every section with a paragraph macro, which mandoc
        # warns about.
        if (l == ".PP" && i > 1 && line[i - 1] ~ /^\.S[HS]( |$)/) continue
        # An old code block: .nf, a line "\f[C]", the code, "\f[R]", .fi.
        if (l == ".nf" && i < NR && line[i + 1] == "\\f[C]") { print ".EX"; i++; continue }
        if (l == "\\f[R]" && i < NR && line[i + 1] == ".fi") { print ".EE"; i++; continue }
        l = font(l, "VBI", "CBI")
        l = font(l, "VB", "CB")
        l = font(l, "VI", "CI")
        l = font(l, "V", "CR")
        l = font(l, "C", "CR")
        print l
    }
}
